{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:site",
  "outputDirectory": "site-build",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/pippo",
      "destination": "/index.html"
    },
    {
      "source": "/pippo/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
