{
  "name": "pippo-mascot",
  "version": "0.1.0",
  "description": "An interactive character that watches the cursor and blinks when you poke it.",
  "license": "MIT",
  "author": "codewithevilxd <codewithevilxd@gmail.com>",
  "homepage": "https://github.com/codewithevilxd/pippo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codewithevilxd/pippo.git"
  },
  "keywords": [
    "mascot",
    "avatar",
    "react",
    "cursor",
    "sprite",
    "portfolio"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "sync:skill": "node -e \"require('node:fs').copyFileSync('src/pippo.tsx', 'skills/pippo/pippo.tsx')\"",
    "check:skill": "node -e \"const fs=require('node:fs'); if (!fs.readFileSync('src/pippo.tsx').equals(fs.readFileSync('skills/pippo/pippo.tsx'))) process.exit(1)\"",
    "build": "tsc -p tsconfig.build.json && npm run sync:skill",
    "build:site": "npm run check:skill && npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build:site && wrangler deploy",
    "screenshots": "node .github/scripts/capture-screenshots.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
